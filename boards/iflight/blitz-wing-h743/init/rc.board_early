#!/bin/sh
# Mount only: never auto-format a card that contains existing flight logs.
set STORAGE_CHECK no
if [ -b /dev/mmcsd0 ]
then
    if mount -t vfat /dev/mmcsd0 /fs/microsd
    then
        set STORAGE_AVAILABLE yes
    else
        echo "WARN [init] microSD mount failed; check card filesystem"
    fi
fi
